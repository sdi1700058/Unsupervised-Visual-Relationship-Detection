#!/usr/bin/env bash
# KIT Bimanual role clips, one for each manipulation cycle of a hand, from
# takes 0 to 9 of the nine tasks of subjects 2 to 6.
#
# Plan workbench/notes/plans/2026-10-05-dataset-fixes.md, F5. Take 0 alone
# gave 43 cycles with all three roles on 2026-10-05, too few to hold out two
# whole subjects, so it took takes 0 to 4, and on 2026-10-06 the author asked
# for all ten, because KIT stayed the weakest. It unpacks the RGB of
# those takes first; unzip -n skips what is on disk. Each take fits its own
# camera, and a take whose held-out error is above 10 px is dropped.
#
#   sbatch sh/convert_kit3d_roles.sbatch
#SBATCH --job-name=convert-kit3d-roles
#SBATCH --partition=normal
#SBATCH --time=16:00:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err

set -eo pipefail
ROOT="${SLURM_SUBMIT_DIR:-$PWD}"
cd "${ROOT}"
RAW=data/video/kit_bimanual/raw
RGB=data/video/kit_bimanual/rgb_ext
for s in 2 3 4 5 6; do
    unzip -q -n "${RAW}/bimacs_rgbd_data_subject_${s}.zip" \
        "bimacs_rgbd_data/subject_${s}/*/take_[0-9]/rgb/*" -d "${RGB}"
    echo "subject ${s}: $(find "${RGB}/bimacs_rgbd_data/subject_${s}" -name '*.png' | wc -l) png"
done
.venv-local/bin/python tools/video/convert_kit3d.py \
    --derived data/video/kit_bimanual/ext/bimacs_derived_data \
    --rgb "${RGB}/bimacs_rgbd_data" \
    --takes 2:task_1_k_cooking:0 2:task_1_k_cooking:1 2:task_1_k_cooking:2 2:task_1_k_cooking:3 2:task_1_k_cooking:4 2:task_1_k_cooking:5 2:task_1_k_cooking:6 2:task_1_k_cooking:7 2:task_1_k_cooking:8 2:task_1_k_cooking:9 2:task_2_k_cooking_with_bowls:0 2:task_2_k_cooking_with_bowls:1 2:task_2_k_cooking_with_bowls:2 2:task_2_k_cooking_with_bowls:3 2:task_2_k_cooking_with_bowls:4 2:task_2_k_cooking_with_bowls:5 2:task_2_k_cooking_with_bowls:6 2:task_2_k_cooking_with_bowls:7 2:task_2_k_cooking_with_bowls:8 2:task_2_k_cooking_with_bowls:9 2:task_3_k_pouring:0 2:task_3_k_pouring:1 2:task_3_k_pouring:2 2:task_3_k_pouring:3 2:task_3_k_pouring:4 2:task_3_k_pouring:5 2:task_3_k_pouring:6 2:task_3_k_pouring:7 2:task_3_k_pouring:8 2:task_3_k_pouring:9 2:task_4_k_wiping:0 2:task_4_k_wiping:1 2:task_4_k_wiping:2 2:task_4_k_wiping:3 2:task_4_k_wiping:4 2:task_4_k_wiping:5 2:task_4_k_wiping:6 2:task_4_k_wiping:7 2:task_4_k_wiping:8 2:task_4_k_wiping:9 2:task_5_k_cereals:0 2:task_5_k_cereals:1 2:task_5_k_cereals:2 2:task_5_k_cereals:3 2:task_5_k_cereals:4 2:task_5_k_cereals:5 2:task_5_k_cereals:6 2:task_5_k_cereals:7 2:task_5_k_cereals:8 2:task_5_k_cereals:9 2:task_6_w_hard_drive:0 2:task_6_w_hard_drive:1 2:task_6_w_hard_drive:2 2:task_6_w_hard_drive:3 2:task_6_w_hard_drive:4 2:task_6_w_hard_drive:5 2:task_6_w_hard_drive:6 2:task_6_w_hard_drive:7 2:task_6_w_hard_drive:8 2:task_6_w_hard_drive:9 2:task_7_w_free_hard_drive:0 2:task_7_w_free_hard_drive:1 2:task_7_w_free_hard_drive:2 2:task_7_w_free_hard_drive:3 2:task_7_w_free_hard_drive:4 2:task_7_w_free_hard_drive:5 2:task_7_w_free_hard_drive:6 2:task_7_w_free_hard_drive:7 2:task_7_w_free_hard_drive:8 2:task_7_w_free_hard_drive:9 2:task_8_w_hammering:0 2:task_8_w_hammering:1 2:task_8_w_hammering:2 2:task_8_w_hammering:3 2:task_8_w_hammering:4 2:task_8_w_hammering:5 2:task_8_w_hammering:6 2:task_8_w_hammering:7 2:task_8_w_hammering:8 2:task_8_w_hammering:9 2:task_9_w_sawing:0 2:task_9_w_sawing:1 2:task_9_w_sawing:2 2:task_9_w_sawing: